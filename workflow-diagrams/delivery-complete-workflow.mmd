```mermaid
%%{init: {'theme': 'dark'}}%%
sequenceDiagram
    actor Driver
    participant GW as API Gateway
    participant DS as delivery-service
    participant WMS as wms-adapter
    participant WMSDB as WMS Legacy (HTTP)
    participant CMS as cms-adapter
    participant CMSDB as CMS Legacy (SOAP)
    participant NS as notify-service

    rect rgb(20, 60, 40)
        note over Driver, NS: Complete or Reject a Delivery — PATCH /deliveries
        Driver->>GW: PATCH /deliveries { orderId, status: completed|rejected, signatureUrl } (Authorization: Bearer JWT)
        note right of GW: Validates JWT, injects x-username + x-role
        GW->>DS: PATCH / (x-username, x-role injected)
        note right of DS: Validates role = driver<br/>Validates status ∈ {completed, rejected}<br/>Requires signatureUrl when status = completed
        DS-->>GW: 200 "Delivery {status} — updates dispatched"
        GW-->>Driver: 200 "Delivery {status} — updates dispatched"

        par Fire all three in parallel
            DS-->>WMS: wms.delivery.update_status { correlationId, orderId, deliveryStatus: delivered|rejected, signatureUrl? }
            WMS->>WMSDB: PATCH /api/wms/delivery-status { orderId, deliveryStatus, signatureUrl }
            note right of WMSDB: reservation.deliveryStatus = delivered | rejected<br/>reservation.signatureUrl = url (completed only)
        and
            DS-->>CMS: cms.order.update_status { correlationId, orderId, status: delivered|rejected }
            CMS->>CMSDB: UpdateOrderStatus (SOAP) { orderId, status }
            note right of CMSDB: Order status updated to delivered | rejected
        and
            DS-->>NS: notify.delivery.status { persist:0, userId: driverUsername, payload: { event, orderId, deliveryStatus, signatureUrl? } }
            NS-->>Driver: WS delivery_status { orderId, deliveryStatus, signatureUrl? }
        end
    end

    rect rgb(80, 20, 20)
        note over Driver, GW: Validation Errors (short-circuit before any publishes)

        alt role ≠ driver
            Driver->>GW: PATCH /deliveries (x-role: client)
            GW-->>Driver: 403 "Only drivers can complete deliveries"
        else missing orderId or status
            Driver->>GW: PATCH /deliveries { status: completed }
            GW-->>Driver: 400 "orderId and status are required"
        else status not in {completed, rejected}
            Driver->>GW: PATCH /deliveries { orderId, status: unknown }
            GW-->>Driver: 400 "status must be 'completed' or 'rejected'"
        else status = completed but no signatureUrl
            Driver->>GW: PATCH /deliveries { orderId, status: completed }
            GW-->>Driver: 400 "signatureUrl is required for completed deliveries"
        end
    end
```
